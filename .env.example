# Cephalon Archive — environment template (copy to `.env` and fill in).
# Never commit the real `.env` (gitignored).

# Discord bot token (secret).
DISCORD_TOKEN=

# Discord user ID of the Creator (numeric snowflake). The Oracle bot compares
# `message.author.id` against this value to select the persona banner —
# Directive Zéro (affection + Ordis glitches) for the Creator, protective
# hostility for any other organic. Leave empty to disable the feature.
CREATOR_DISCORD_ID=