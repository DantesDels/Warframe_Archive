# Cephalon Archive — environment template (copy to `.env` and fill in).
# Never commit the real `.env` (gitignored).

# Discord bot token (secret).
DISCORD_TOKEN=

# Discord user ID of the Creator (numeric snowflake). The Oracle bot compares
# `message.author.id` against this value to select the persona banner —
# Directive Zéro (affection + Ordis glitches) for the Creator, protective
# hostility for any other organic. Leave empty to disable the feature.
CREATOR_DISCORD_ID=

# Discord role hierarchy file (mission-8): maps each server role name to its
# real Discord snowflake, grouped by category (commandement / structure_clan /
# affiliations / generaux). Template: discord_roles.example.json.
# Default: discord_roles.json at the project root.
# DISCORD_ROLES_FILE=discord_roles.json

# ENGRAM: per-user short-term memory (sliding pairs, inactivity expiry, LRU).
# The X last request/reply pairs per `message.author.id`.
# ENGRAM_MEMORY_PAIRS=4
# Wipe a silent user's history after Y seconds of inactivity.
# ENGRAM_MEMORY_EXPIRY=1800
# Upper bound of tracked users (LRU eviction).
# ENGRAM_MEMORY_MAX_USERS=64

# ENGRAM: chat backend selected by the hexagonal LLM port
# (lmstudio | nvidia | gemini). Embeddings always stay local (BGE-M3) on
# ENGRAM_LLM_BASE, whatever the chat backend.
# ENGRAM_LLM_PROVIDER=lmstudio

# NVIDIA NIM (remote chat only): the adapter is enabled by its key.
# ENGRAM_NVIDIA_KEY=
# ENGRAM_NVIDIA_BASE=https://integrate.api.nvidia.com/v1
# ENGRAM_NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# Google Gemini (remote chat only): the adapter is enabled by its key.
# ENGRAM_GEMINI_KEY=
# ENGRAM_GEMINI_BASE=https://generativelanguage.googleapis.com/v1beta
# ENGRAM_GEMINI_MODEL=gemini-2.0-flash
